# Copy this file to .env and fill in real values from the Camunda Console
# (Cluster -> API -> Client credentials). .env is gitignored, so this file
# is the only place new teammates can see which keys are required.
#
# Without these set, the server silently returns empty results ([]) for
# every Zeebe/Optimize-backed endpoint instead of erroring — see the
# [debug ...] logs in the terminal (ensureZeebeConfigured/ensureOptimizeConfigured)
# to confirm whether this is your issue.

ZEEBE_CLIENT_ID=
ZEEBE_CLIENT_SECRET=
ZEEBE_AUTHORIZATION_SERVER_URL=https://login.cloud.camunda.io/oauth/token
ZEEBE_REST_ADDRESS=
ZEEBE_GRPC_ADDRESS=
ZEEBE_TOKEN_AUDIENCE=zeebe.camunda.io

CAMUNDA_TOKEN_AUDIENCE=zeebe.camunda.io
CAMUNDA_CLUSTER_ID=
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
CAMUNDA_CLUSTER_REGION=
CAMUNDA_CREDENTIALS_SCOPES=

CAMUNDA_TASKLIST_BASE_URL=
CAMUNDA_OPTIMIZE_BASE_URL=
CAMUNDA_OPERATE_BASE_URL=
CAMUNDA_OAUTH_URL=https://login.cloud.camunda.io/oauth/token
CAMUNDA_CLIENT_MODE=saas
CAMUNDA_CLIENT_AUTH_CLIENTID=
CAMUNDA_CLIENT_AUTH_CLIENTSECRET=
CAMUNDA_OPTIMIZE_COLLECTION_ID=

PORT=3000
